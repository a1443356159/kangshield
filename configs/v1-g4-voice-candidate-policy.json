{
  "schema_version": "1.0",
  "policy_id": "v1-g4-voice-candidate-policy",
  "matcher_revision": "voice-candidate-matcher-v0.1.0",
  "matcher_type": "deterministic_keyword",
  "llm_allowed": false,
  "categories": {
    "help_request": {
      "keywords": ["救命", "帮帮我", "帮我一下", "快来人"]
    },
    "fall_related": {
      "keywords": ["摔倒", "跌倒", "摔了", "起不来"]
    }
  },
  "hard_negative_categories": [
    "negation",
    "reported_speech",
    "tv_or_phone_playback",
    "asr_error",
    "multi_person_overlap",
    "environmental_noise"
  ],
  "output_rules": {
    "risk_assessment_emitted": false,
    "voice_candidate_alone_never_confirms_fall": true,
    "transcript_visibility": "owner_only",
    "public_evidence_fields": ["category", "time_range", "count", "quality", "status", "limitations"]
  },
  "limitations": [
    "keyword_matcher_is_a_candidate_policy_not_frozen_for_scoring",
    "hard_negative_evaluation_requires_dev_set_a_capture",
    "fraud_related_is_out_of_d1_scope"
  ]
}
